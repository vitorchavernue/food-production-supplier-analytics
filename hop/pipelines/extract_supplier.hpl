<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>extract_supplier</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Integrated farms (suppliers): rows of ERP table FORNECEDOR (Oracle) changed since the last load, into stg.supplier (PostgreSQL)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/29 22:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/29 22:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Read watermark (DW)</from>
      <to>Read changed FORNECEDOR (ERP)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read changed FORNECEDOR (ERP)</from>
      <to>CNPJ digits, trim names</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>CNPJ digits, trim names</from>
      <to>Write stg.supplier</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read watermark (DW)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dw</connection>
    <sql>SELECT last_updated_at FROM etl.watermark WHERE source_table = 'FORNECEDOR'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Read changed FORNECEDOR (ERP)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>erp</connection>
    <sql>SELECT COD_FORNECEDOR       AS "supplier_code",
       RAZAO_SOCIAL         AS "legal_name",
       CNPJ                 AS "cnpj_typed",
       CNPJ                 AS "cnpj",
       CIDADE               AS "city",
       UF                   AS "state",
       COD_UNIDADE          AS "plant_code",
       DISTANCIA_KM         AS "distance_km",
       DT_INICIO_INTEGRACAO AS "integration_start",
       SITUACAO             AS "active_flag",
       DT_ATUALIZACAO       AS "source_updated_at"
FROM FORNECEDOR
WHERE DT_ATUALIZACAO &gt; CAST(? AS DATE) - 5 / 1440</sql>
    <limit>0</limit>
    <lookup>Read watermark (DW)</lookup>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>CNPJ digits, trim names</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>cnpj</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>digits_only</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>legal_name</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>city</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write stg.supplier</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>5000</commit>
    <connection>dw</connection>
    <fields>
    </fields>
    <return_field/>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>stg</schema>
    <specify_fields>N</specify_fields>
    <table>supplier</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>800</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
