      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>624</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Stop: quality gate failed</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <message>Critical data quality check failed: data not released, watermarks kept</message>
      <parallel>N</parallel>
      <xloc>928</xloc>
      <yloc>624</yloc>
      <attributes_hac/>
    </action>
    <action>
