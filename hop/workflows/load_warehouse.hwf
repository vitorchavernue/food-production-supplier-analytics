      <attributes_hac/>
    </action>
    <action>
      <name>Run quality checks</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/../sql/dml/30_quality_checks.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>dw</connection>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Release gate: no critical check failed</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>dw</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT check_name
FROM dq.check_result
WHERE run_id = (SELECT MAX(run_id) FROM etl.run_log)
  AND severity = 'critical'
  AND NOT passed</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <xloc>688</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Close the run (watermarks advance)</name>
